# Copy to .env (git-ignored) and fill in. Passwords are embedded in connection strings, so avoid ; ' and " in them.

# Postgres superuser (admin and backups only; bots never use it).
POSTGRES_PASSWORD=

# Villager Bot
VILLAGER_BOT_DB_PASSWORD=
VILLAGER_BOT_DISCORD_TOKEN=
# Which server's IDs to use: Production (live) or Test. Use the matching bot token.
VILLAGER_BOT_ENVIRONMENT=Production
